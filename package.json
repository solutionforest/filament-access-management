{
    "private": true,
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/plugin.css -o resources/dist/filament-access-management.css --watch",
        "dev:scripts": "esbuild resources/js/plugin.js --bundle --sourcemap=inline --outfile=resources/dist/filament-access-management.js --watch",
        "build:styles": "npx @tailwindcss/cli -i resources/css/plugin.css -o resources/dist/filament-access-management.css --minify && npm run purge",
        "build:scripts": "esbuild resources/js/plugin.js --bundle --minify --outfile=resources/dist/filament-access-management.js",
        "purge": "filament-purge -i resources/dist/filament-access-management.css -o resources/dist/filament-access-management.css",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.0.2",
        "@tailwindcss/cli": "^4.0.0",
        "esbuild": "^0.8.57",
        "npm-run-all": "^4.1.5",
        "prettier": "^2.7.1",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^4.0.0"
    }
}
