{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/plugin.css -o resources/dist/filament-access-management.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx @tailwindcss/cli -i resources/css/plugin.css -o resources/dist/filament-access-management.css --minify",
        "build:scripts": "node bin/build.js",
        "purge": "filament-purge -i resources/dist/filament-access-management.css -o resources/dist/filament-access-management.css",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.0.2",
        "@tailwindcss/cli": "^4.0.0",
        "esbuild": "^0.28.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^4.0.0"
    }
}
